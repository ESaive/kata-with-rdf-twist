@prefix gr: <http://example.org/gilded-rose#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Classes
gr:Item a rdfs:Class ;
    rdfs:label "Item" ;
    rdfs:comment "An item in the Gilded Rose inventory" .

gr:ItemType a rdfs:Class ;
    rdfs:label "Item Type" ;
    rdfs:comment "A category of items with specific update rules" .

# Properties
gr:name a rdf:Property ;
    rdfs:domain gr:Item ;
    rdfs:range xsd:string ;
    rdfs:label "name" .

gr:sellIn a rdf:Property ;
    rdfs:domain gr:Item ;
    rdfs:range xsd:integer ;
    rdfs:label "sell in" ;
    rdfs:comment "Number of days to sell the item" .

gr:quality a rdf:Property ;
    rdfs:domain gr:Item ;
    rdfs:range xsd:integer ;
    rdfs:label "quality" ;
    rdfs:comment "Quality value of the item" .

gr:itemType a rdf:Property ;
    rdfs:domain gr:Item ;
    rdfs:range gr:ItemType ;
    rdfs:label "item type" .

# Item Types (examples - you may need to add more)
gr:NormalItem a gr:ItemType ;
    rdfs:label "Normal Item" ;
    rdfs:comment "Standard items that degrade in quality" .

gr:AgedBrie a gr:ItemType ;
    rdfs:label "Aged Brie" ;
    rdfs:comment "Increases in quality over time" .

gr:Sulfuras a gr:ItemType ;
    rdfs:label "Sulfuras" ;
    rdfs:comment "Legendary item that never changes" .

gr:BackstagePass a gr:ItemType ;
    rdfs:label "Backstage Pass" ;
    rdfs:comment "Increases in quality as concert approaches, drops to 0 after" .


gr:Conjured a gr:ItemType ;
    rdfs:label "Conjured Items" ;
    rdfs:comment "items degrade in Quality twice as fast as normal items" .

##################################
# Business rule constraints - metadata properties
##################################

gr:maxQuality a rdf:Property ;
    rdfs:domain gr:ItemType ;
    rdfs:range xsd:integer .

gr:minQuality a rdf:Property ;
    rdfs:domain gr:ItemType ;
    rdfs:range xsd:integer .

gr:isLegendary a rdf:Property ;
    rdfs:domain gr:ItemType ;
    rdfs:range xsd:boolean .

gr:qualityChange a rdf:Property ;
    rdfs:domain gr:ItemType ;
    rdfs:range xsd:integer ;
    rdfs:comment "Daily quality change before sell date" .

gr:qualityChangeAfterSellDate a rdf:Property ;
    rdfs:domain gr:ItemType ;
    rdfs:range xsd:integer ;
    rdfs:comment "Daily quality change after sell date" .


##################################
# Item Types + rules
##################################

gr:Normal a gr:ItemType ;
    rdfs:label "Normal Item" ;
    gr:qualityChange -1 ;
    gr:qualityChangeAfterSellDate -2 ;
    gr:maxQuality 50 ;
    gr:minQuality 0 ;
    gr:isLegendary false .

gr:AgedBrie a gr:ItemType ;
    rdfs:label "Aged Brie" ;
    gr:qualityChange 1 ;
    gr:maxQuality 50 ;
    gr:minQuality 0 ;
    gr:isLegendary false .

gr:Sulfuras a gr:ItemType ;
    rdfs:label "Sulfuras" ;
    gr:maxQuality 80 ;
    gr:minQuality 80 ;
    gr:isLegendary true .

gr:BackstagePass a gr:ItemType ;
    rdfs:label "Backstage Pass" ;
    gr:maxQuality 50 ;
    gr:minQuality 0 ;
    gr:isLegendary false ;
    rdfs:comment "Special staged increases handled in logic layer" .

gr:Conjured a gr:ItemType ;
    rdfs:label "Conjured Item" ;
    gr:qualityChange -2 ;
    gr:qualityChangeAfterSellDate -4 ;
    gr:maxQuality 50 ;
    gr:minQuality 0 ;
    gr:isLegendary false .